SECRET_KEY=change-me-for-local-demo

# Default demo user is admin / admin123 (hash below).
# Regenerate: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$ddLc8R3zDrUHe4W9$a5f588fec21f6e1ad6fd8d8be4dfef11b1d0116fe5c7a7673186d44283eb365d2e928f6ab97a9242b4669003a3254d37c042c05864523cb8459def446944ca41

# Shared token for agent -> Flask ingest (header X-Agent-Token)
INGEST_TOKEN=demo-ingest-token

